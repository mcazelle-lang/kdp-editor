# Copier ce fichier en server/.env (jamais versionné) puis redémarrer le serveur.

# --- Assistant IA (Claude) : obligatoire pour l'onglet « Assistant IA »
# Clé créée sur https://platform.claude.com (API Keys)
ANTHROPIC_API_KEY=
# Modèle et niveau d'effort (low | medium | high | xhigh | max)
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high
# Nombre maximal d'allers-retours outil par exécution
AGENT_MAX_ITERATIONS=24

# --- Illustrations de couverture (facultatif) : modèles d'image Gemini
# Imagen a été arrêté le 17/08/2026 ; clé Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# --- Serveur
PORT=3000
# Origines autorisées (CORS), séparées par des virgules.
# Par défaut : http://localhost:4200 et les domaines Firebase Hosting du projet de .firebaserc
# CORS_ORIGINS=https://kdp-creator-studio.web.app,https://kdp-creator-studio.firebaseapp.com
